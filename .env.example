# --- Your own Supabase project (Project Settings -> API) ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
# Service role key: Project Settings -> API -> service_role. Server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# Same values, exposed to the browser build (Vite requires the VITE_ prefix for client-side env vars)
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# --- Groq (used server-side only by the chat function, no VITE_ prefix) ---
GROQ_API_KEY="your-groq-api-key"
